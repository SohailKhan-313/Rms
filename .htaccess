# RMS Apache Configuration & URL Router
RewriteEngine On
Options +FollowSymLinks -Indexes

# If root URL is requested, internally serve public/index.php without external redirect
RewriteRule ^$ public/index.php [L]

# Ensure UTF-8 default charset
AddDefaultCharset UTF-8

# Security: Deny direct access to sensitive configuration files
<FilesMatch "^(composer\.(json|lock)|schema\.sql|\.env|\.git.*)$">
    Require all denied
</FilesMatch>
